APP_ENV=prod
APP_DEBUG=0
APP_SECRET=CHANGE_ME_32_CHARS_MIN
# Trust only proxies on private networks, such as the platform's load balancer. Symfony then
# takes the last public address in X-Forwarded-For as the client IP, so entries a client adds
# itself are ignored. Symfony does not read "*" as a wildcard: it trusts no proxy, and every
# client behind the load balancer shares one login and registration rate-limit bucket.
SYMFONY_TRUSTED_PROXIES=PRIVATE_SUBNETS
# Lock store for the rate limiters. flock is enough for one container; use a store they all reach
# when several containers share the rate-limiter cache.
LOCK_DSN=flock

# Use your production database (prefer PostgreSQL/MySQL managed service).
# Example MySQL:
# DATABASE_URL="mysql://app_user:CHANGE_ME@db-host:3306/app_db?serverVersion=8.0.32&charset=utf8mb4"
DATABASE_URL=

# Restrict CORS to your frontend domain.
CORS_ALLOW_ORIGIN='^https://example\\.com$'
FRONTEND_URL=https://example.com

# External API key used by the backend integration.
API_KEY=

# Optional mail transport for prod.
# MAILER_DSN=smtp://user:pass@smtp.example.com:587
