APP_ENV=prod
APP_DEBUG=0
APP_SECRET=CHANGE_ME_32_CHARS_MIN
# Caddy is the only service that reaches the backend: the backend port is not published,
# only Caddy's 80 and 443 are. REMOTE_ADDR therefore trusts Caddy alone. Caddy replaces any
# X-Forwarded-For the client sends with the client's IP, so the rate limiters see the real
# client and a client cannot pick its own address. Symfony does not read "*" as a wildcard:
# it trusts no proxy, and every client would share one rate-limit bucket.
SYMFONY_TRUSTED_PROXIES=REMOTE_ADDR
# Lock store for the rate limiters. flock is enough for one container; use a store they all reach
# when several containers share the rate-limiter cache.
LOCK_DSN=flock

# Use your production MySQL database. The runtime image ships pdo_mysql only.
# Example MySQL:
# DATABASE_URL="mysql://app_user:CHANGE_ME@db-host:3306/app_db?serverVersion=8.0.32&charset=utf8mb4"
DATABASE_URL=

# Restrict CORS to your frontend domain.
CORS_ALLOW_ORIGIN='^https://example\\.com$'
FRONTEND_URL=https://example.com

# External API key used by the backend integration.

# Optional mail transport for prod.
# MAILER_DSN=smtp://user:pass@smtp.example.com:587
