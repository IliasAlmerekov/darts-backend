server {
    listen __PORT__;
    server_name _;
    root /app/public;
    index index.php;

    # The API takes JSON and urlencoded login forms only. Multipart bodies never reach PHP:
    # its multipart parser is the main OOM trigger of CVE-2026-109618 (GHSA-w8hw-w9fx-j79w).
    if ($http_content_type ~* "^\s*multipart/") {
        return 415;
    }

    location / {
        try_files $uri /index.php$is_args$args;
    }

    location ~ ^/index\.php(/|$) {
        fastcgi_pass 127.0.0.1:9000;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        # Server-sent events: pass each chunk on at once and keep idle streams open.
        fastcgi_buffering off;
        fastcgi_read_timeout 3600s;
        internal;
    }

    location ~ \.php$ {
        return 404;
    }
}
